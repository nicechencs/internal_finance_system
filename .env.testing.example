# Testing deployment environment template
# Copy this file to .env.testing on the testing server.

GITHUB_REPO_OWNER=your-github-username

# Testing database settings.
# Point these values to a dedicated testing database.
# When the database runs on the Docker host, host.docker.internal works
# because docker-compose.testing.yml adds a host-gateway mapping.
DB_HOST=host.docker.internal
DB_PORT=5432
DB_NAME=finance_test
DB_USER=postgres
DB_PASSWORD=change-me-testing-database-password

BACKUP_RETENTION_DAYS=7
BACKUP_DIR=backups/testing

WEB_PORT=8081
AUTH_COOKIE_SECURE_POLICY=SameAsRequest

BOOTSTRAP_ADMIN_ENABLED=true
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-me-testing-admin-password
BOOTSTRAP_ADMIN_FULL_NAME=Testing Administrator
BOOTSTRAP_ADMIN_EMAIL=admin@example.com

CORS_ALLOWED_ORIGIN=http://localhost:8081
