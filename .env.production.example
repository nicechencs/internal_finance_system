# ============================================
# 生产环境配置模板
# ============================================
# 使用说明：
# 1. 复制此文件为 .env.production
# 2. 填写实际的配置值
# 3. 确保 .env.production 不被提交到 Git
# ============================================

# ============================================
# 镜像命名配置
# ============================================
# 生产镜像所有者（GitHub 用户名或组织名，用于拉取 ghcr.io 镜像）。
GITHUB_REPO_OWNER=your-github-username

# ============================================
# 数据库配置（外部数据库）
# ============================================
# 数据库主机地址
# - 如果数据库在同一服务器：localhost 或 host.docker.internal
# - 如果数据库在其他 Docker 容器：容器名称或 IP
# - 如果数据库在远程服务器：远程 IP 或域名
DB_HOST=host.docker.internal

# 数据库端口（默认 5432）
DB_PORT=5432

# 数据库名称
DB_NAME=finance

# 数据库用户名
DB_USER=postgres

# PostgreSQL 数据库密码（强密码，建议使用 openssl rand -base64 32 生成）
DB_PASSWORD=your-strong-database-password-here

# 数据库备份保留天数（默认 7 天）
BACKUP_RETENTION_DAYS=7

# 备份目录（默认 ./backups）
BACKUP_DIR=./backups

# ============================================
# 应用端口配置
# ============================================
# 前端服务端口（默认 8080）
WEB_PORT=8080

# Cookie secure policy for auth sessions.
# SameAsRequest works for HTTP deployments and reverse proxies.
# Switch to Always after HTTPS is fully configured end-to-end.
AUTH_COOKIE_SECURE_POLICY=SameAsRequest

# ============================================
# 管理员账户配置
# ============================================
# 是否启用引导管理员账户（首次部署设为 true，后续设为 false）
BOOTSTRAP_ADMIN_ENABLED=true

# 管理员用户名
BOOTSTRAP_ADMIN_USERNAME=admin

# 管理员密码（强密码，建议使用 openssl rand -base64 24 生成）
# 不要使用仓库文档中的演示密码 DemoOnly_ChangeMe!，生产环境会拒绝该占位符。
BOOTSTRAP_ADMIN_PASSWORD=your-admin-password-here

# 管理员全名
BOOTSTRAP_ADMIN_FULL_NAME=系统管理员

# 管理员邮箱
BOOTSTRAP_ADMIN_EMAIL=admin@example.com

# ============================================
# CORS 配置
# ============================================
# 允许的前端访问地址（生产环境应设置为实际域名）
# 示例：http://finance.example.com 或 https://finance.example.com
CORS_ALLOWED_ORIGIN=http://localhost

# ============================================
# 安全建议
# ============================================
# 1. 使用强密码（至少 32 字符，包含大小写字母、数字、特殊字符）
# 2. 定期更换密码（建议每 3-6 个月）
# 3. 不要将此文件提交到 Git 仓库
# 4. 限制文件权限：chmod 600 .env.production
# 5. 首次部署后，将 BOOTSTRAP_ADMIN_ENABLED 改为 false
# ============================================
