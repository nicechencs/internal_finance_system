# ============================================
# 生产环境配置文件
# ============================================
# 使用说明：
# 1. 复制此文件为 .env.production
# 2. 填写所有必需的配置项
# 3. 确保文件权限为 600 (chmod 600 .env.production)
# ============================================

# GitHub 仓库信息
GITHUB_REPO_OWNER=your-github-username

# ============================================
# 数据库配置（外部数据库）
# ============================================
# 数据库主机地址
# - 如果数据库在同一服务器：host.docker.internal
# - 如果数据库在远程服务器：远程 IP 或域名
DB_HOST=host.docker.internal

# 数据库端口（默认 5432）
DB_PORT=5432

# 数据库名称
DB_NAME=finance

# 数据库用户名
DB_USER=postgres

# PostgreSQL 数据库密码（强密码，建议使用 openssl rand -base64 32 生成）
DB_PASSWORD=your_secure_database_password_here

# ============================================
# 初始管理员账户（首次部署时启用）
# ============================================
BOOTSTRAP_ADMIN_ENABLED=true
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=your_admin_password_here
BOOTSTRAP_ADMIN_FULL_NAME=系统管理员
BOOTSTRAP_ADMIN_EMAIL=admin@example.com

# ============================================
# 应用配置
# ============================================
# CORS 配置（生产环境域名）
CORS_ALLOWED_ORIGIN=http://your-domain.com

# 前端服务端口（默认 80）
WEB_PORT=80

# Cookie secure policy
AUTH_COOKIE_SECURE_POLICY=SameAsRequest

# ============================================
# 备份配置
# ============================================
BACKUP_RETENTION_DAYS=7
BACKUP_DIR=/opt/finance/backups
